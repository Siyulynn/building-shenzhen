{
  // sim-core runs in a Web Worker and in Node: no DOM, no Node types (PLAN §6.1–6.2).
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "types": [],
    "lib": ["ES2022"],
    "noEmit": true
  },
  "include": ["src"]
}
