{
  "name": "building-shenzhen",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p packages/sim-core/tsconfig.json",
    "evidence:validate": "tsx packages/evidence/src/cli.ts validate",
    "evidence:status": "tsx packages/evidence/src/cli.ts status",
    "evidence:compile": "tsx packages/evidence/src/cli.ts compile --draft",
    "evidence:compile:strict": "tsx packages/evidence/src/cli.ts compile --strict",
    "check": "npm run typecheck && npm test && npm run evidence:validate",
    "spike:location": "vitest run packages/sim-core/test/location-choice.test.ts",
    "spike:grid": "pipeline/.venv/Scripts/python -I pipeline/spike_a_grid.py",
    "spike:map": "vite apps/map-spike --port 5173 --strictPort",
    "calibration:1982": "pipeline\\.venv\\Scripts\\python -I pipeline/map_1982_georef.py",
    "calibration:1984": "pipeline\\.venv\\Scripts\\python -I pipeline/buildings_1984.py",
    "design:maps": "pipeline\\.venv\\Scripts\\python -I pipeline/make-zoning-maps.py",
    "test:atlas": "vitest run --root apps/snapshot-3d --testTimeout 30000",
    "build:atlas": "vite build apps/snapshot-3d --base ./ --target es2022",
    "publish:atlas": "node apps/snapshot-3d/publish-pages.mjs",
    "slice": "tsx apps/cli/src/main.ts",
    "golden:update": "tsx apps/cli/src/main.ts golden --update",
    "slice:ui": "vite apps/slice-ui --port 5174 --strictPort"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.6",
    "vitest": "^5.1.1",
    "yaml": "^2.9.1",
    "zod": "^3.25.76"
  }
}
